<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" styleClass="login-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mouchy.app.controllers.LoginController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>
    <children>
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Left Banner Pane -->
                <VBox alignment="CENTER" prefWidth="420.0" style="-fx-background-color: #11111b; -fx-padding: 40;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="MOUCHY" textFill="#00e5ff">
                            <font>
                                <Font name="System Bold" size="48.0" />
                            </font>
                        </Label>
                        <Label text="Creative Agency" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="20.0" />
                            </VBox.margin>
                        </Label>
                        <Label alignment="CENTER" lineSpacing="1.5" text="Simplify your project requests. Order digital assets, view progress logs, and collaborate in one single, high-fidelity workspace." textAlignment="CENTER" textFill="#a5a5b1" wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Right Form Pane -->
                <VBox alignment="CENTER" prefWidth="480.0" style="-fx-padding: 50;" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox fx:id="cardContainer" styleClass="card" spacing="25.0" maxWidth="380.0" VBox.vgrow="NEVER">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>
                                <!-- LOGIN FORM -->
                                <VBox fx:id="loginFormPane" spacing="15.0">
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label styleClass="label-header" text="Sign In" />
                                                <Label styleClass="label-subtitle" text="Welcome back! Please enter your details." />
                                            </children>
                                        </VBox>
                                        
                                        <Label fx:id="loginErrorLabel" textFill="#d50000" wrapText="true" visible="false" managed="false" />

                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Username" />
                                                <TextField fx:id="loginUsername" promptText="Enter your username" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Password" />
                                                <PasswordField fx:id="loginPassword" promptText="••••••••" />
                                            </children>
                                        </VBox>

                                        <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary" text="Log In">
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </Button>

                                        <HBox alignment="CENTER" spacing="5.0">
                                            <children>
                                                <Label styleClass="label-subtitle" text="Don't have an account?" />
                                                <Hyperlink onAction="#showRegisterForm" text="Register now" textFill="#7c4dff" style="-fx-underline: true; -fx-padding: 0;" />
                                            </children>
                                            <VBox.margin>
                                                <Insets top="5.0" />
                                            </VBox.margin>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- REGISTER FORM -->
                                <VBox fx:id="registerFormPane" spacing="12.0" visible="false" managed="false">
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label styleClass="label-header" text="Create Account" />
                                                <Label styleClass="label-subtitle" text="Sign up as a client to request agency services." />
                                            </children>
                                        </VBox>

                                        <Label fx:id="regErrorLabel" textFill="#d50000" wrapText="true" visible="false" managed="false" />
                                        <Label fx:id="regSuccessLabel" textFill="#00c853" wrapText="true" visible="false" managed="false" />

                                        <VBox spacing="3.0">
                                            <children>
                                                <Label text="Full Name" />
                                                <TextField fx:id="regFullName" promptText="John Doe" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="3.0">
                                            <children>
                                                <Label text="Email Address" />
                                                <TextField fx:id="regEmail" promptText="john@example.com" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="3.0">
                                            <children>
                                                <Label text="Phone Number" />
                                                <TextField fx:id="regPhone" promptText="Digits only" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="3.0">
                                            <children>
                                                <Label text="Username" />
                                                <TextField fx:id="regUsername" promptText="Choose a username" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="3.0">
                                            <children>
                                                <Label text="Password" />
                                                <PasswordField fx:id="regPassword" promptText="Choose a password" />
                                            </children>
                                        </VBox>

                                        <Button fx:id="registerButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegister" styleClass="btn-primary" text="Sign Up">
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </Button>

                                        <HBox alignment="CENTER" spacing="5.0">
                                            <children>
                                                <Label styleClass="label-subtitle" text="Already have an account?" />
                                                <Hyperlink onAction="#showLoginForm" text="Sign in" textFill="#7c4dff" style="-fx-underline: true; -fx-padding: 0;" />
                                            </children>
                                            <VBox.margin>
                                                <Insets top="5.0" />
                                            </VBox.margin>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
